{
  "name": "hw1-enterprise-data-grid",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "npm run test:unit && npm run test:components",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:components": "tsx --tsconfig tsconfig.app.json --test tests/data-grid-coverage.test.tsx tests/data-grid-keyboard.test.tsx tests/data-grid-selection.test.tsx tests/data-grid-sorting.test.tsx tests/reproductions/pagination-filter-stale-page.repro.test.tsx",
    "test:t-05.1": "tsx --tsconfig tsconfig.app.json --test tests/data-grid-selection.test.tsx"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "~5.8.0",
    "vite": "^6.0.0"
  }
}
